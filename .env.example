# ─── AI Provider (pick ONE) ───────────────────────────────────────────────────
# Default: groq  |  Options: groq · gemini · openrouter
AI_PROVIDER=groq

# ─── Groq (recommended for students — fast + free) ────────────────────────────
# Sign up free → https://console.groq.com
# Free tier: 14,400 requests/day, no credit card needed
GROQ_API_KEY=gsk_...

# ─── Google Gemini (alternative free option) ──────────────────────────────────
# Get free key → https://aistudio.google.com/app/apikey
# Free tier: 15 requests/min, 1,500 requests/day
# GEMINI_API_KEY=AIza...

# ─── OpenRouter (access many free models) ─────────────────────────────────────
# Sign up → https://openrouter.ai — free credits on signup
# Free models: mistralai/mistral-7b-instruct:free, meta-llama/llama-3-8b-instruct:free
# OPENROUTER_API_KEY=sk-or-...

# ─── Override model (optional) ────────────────────────────────────────────────
# AI_MODEL=llama-3.3-70b-versatile     # for groq
# AI_MODEL=gemini-1.5-flash            # for gemini
# AI_MODEL=mistralai/mistral-7b-instruct:free   # for openrouter

# ─── Google Places API (optional — for real competitor data) ──────────────────
# Free tier: 300 calls/month
# console.cloud.google.com → Enable "Places API" → Credentials
# NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=AIza...

# ─── Site URL (needed for OpenRouter header) ──────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
